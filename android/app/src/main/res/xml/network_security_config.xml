<?xml version="1.0" encoding="utf-8"?>
<!-- The server is only reachable through Tailscale, which already encrypts all
     traffic (WireGuard), so plain http to the tailnet is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
